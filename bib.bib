    author = {Baron, Dalya and Netzer, Hagai and French, K Decker and Lutz, Dieter and Davies, Richard I and Prochaska, J Xavier},
    title = {Star formation and molecular gas properties of post-starburst galaxies},
    journal = {Monthly Notices of the Royal Astronomical Society},
